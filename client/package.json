{
  "name": "conquerors-domination-demo",
  "private": true,
  "version": "0.0.0",
  "author": "Thecoadstar",
  "description": "Conquerors Domination Demo by Thecoadstar.",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/tajharker-star/OG.git"
  },
  "scripts": {
    "dev": "vite",
    "electron": "unset ELECTRON_RUN_AS_NODE && electron electron/main.cjs",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && unset ELECTRON_RUN_AS_NODE && NODE_ENV=development electron electron/main.cjs\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && npm run build-server && electron-builder",
    "dist:steam": "npm run build && npm run build-server && node scripts/build-steam-artifacts.mjs && npm run stage:steam && npm run verify:steam-layout && npm run verify:release-binaries && npm run verify:steam-runtime && npm run smoke:packaged-server && npm run smoke:packaged && npm run smoke:windows:wine",
    "build:steam-store-assets": "node scripts/build-steam-store-assets.mjs",
    "steam:upload:demo": "node scripts/steam-deploy.mjs demo",
    "steam:upload:main": "node scripts/steam-deploy.mjs main",
    "steam:set-live": "node scripts/steam-set-live.mjs",
    "test:smoke": "playwright test",
    "build-server": "cd ../server && npm run build && cd ../client && mkdir -p server && cp -r ../server/dist server/",
    "lint": "eslint .",
    "preview": "vite preview",
    "stage:steam": "node scripts/stage-steam-releases.mjs",
    "smoke:packaged": "node scripts/smoke-test-packaged.mjs",
    "smoke:packaged-server": "node scripts/smoke-test-packaged-server.mjs",
    "smoke:windows:wine": "node scripts/smoke-test-windows-wine.mjs",
    "verify:steam-install": "node scripts/verify-steam-install.mjs",
    "verify:steam-layout": "node scripts/verify-steam-layout.mjs",
    "verify:release-binaries": "node scripts/verify-release-binaries.mjs",
    "verify:steam-runtime": "node scripts/verify-steam-runtime.mjs"
  },
  "build": {
    "appId": "com.conquerors.domination.demo",
    "productName": "ConquerorsDominationDemo",
    "executableName": "ConquerorsDominationDemo",
    "copyright": "Copyright © 2026 Thecoadstar",
    "icon": "electron/icons/app-icon.png",
    "afterSign": "scripts/notarize.mjs",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "steam_appid.txt"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "server",
        "to": "server",
        "filter": [
          "dist/**/*",
          "node_modules/**/*",
          "package.json"
        ]
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "electron/icons/app-icon.icns",
      "category": "public.app-category.strategy-games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 Thecoadstar"
      }
    },
    "win": {
      "target": "dir",
      "icon": "electron/icons/app-icon.ico",
      "executableName": "ConquerorsDominationDemo"
    },
    "linux": {
      "target": "dir",
      "icon": "electron/icons/app-icon.png",
      "executableName": "conquerors-domination-demo"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.5.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
